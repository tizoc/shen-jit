(define net-interface-test.expect
  {boolean --> string --> boolean}
  true _ -> true
  false Name -> (error "IPv4 interface test failed at ~A" Name))

(define net-interface-test.fill
  {buffer.view --> fixnum --> (list fixnum) --> buffer.view}
  B _ [] -> B
  B I [X | Rest] -> (net-interface-test.fill (buffer.u8-> B I X) (fx+ I 1) Rest))

\\ Wire fixtures computed independently, including a three-byte ICMP payload.
(define net-interface-test.run
  {--> boolean}
  -> (let L (net-link.make 4 64 0 (freeze 0))
          Left (net-link.left L)
          Right (net-link.right L)
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          F (net-interface.make Right B 7 1 100 7 1)
          U (udp.bind Left A 12345)
          Payload (buffer.from-string "abc")
          Out (buffer.new 3)
          Short (buffer.new 2)
          Info (udp.make-recv-info)
          Request (net-interface-test.fill (buffer.new 31) 0
                    [69 0 0 31 0 0 64 0 64 1 182 218 192 0 2 1 192 0 2 2 8 0 33 88 18 3 0 66 97 98 99])
          Reply (net-interface-test.fill (buffer.new 31) 0
                  [69 0 0 31 0 0 64 0 64 1 182 218 192 0 2 2 192 0 2 1 0 0 41 88 18 3 0 66 97 98 99])
          Wire (buffer.new 31)
       (do (buffer.u8-> Request 30 100)
           (net-interface-test.expect (= (net-link.packet-send Left Request 31) net-link.sent) "queue bad ICMP checksum")
           (buffer.u8-> Request 30 99)
           (net-interface-test.expect (= (udp.send U B 7 Payload 3) udp.sent) "queue UDP")
           (net-interface-test.expect (= (udp.send U B 7 Payload 2) udp.sent) "queue UDP overflow")
           (net-interface-test.expect (= (net-link.packet-send Left Request 31) net-link.sent) "queue valid ICMP")
           (net-interface-test.expect (= (net-interface.poll F 0) 0) "zero ingress budget")
           (net-interface-test.expect (= (net-interface.poll F 2) 2) "discard and enqueue within budget")
           (net-interface-test.expect (= (net-link.packet-recv-into Left Wire) -1) "bad ICMP earns no reply")
           (net-interface-test.expect (= (net-interface.udp-dropped F) 0) "overflow is still on ingress")
           (net-interface-test.expect (= (net-interface.poll F 2) 2) "progress past UDP overflow")
           (net-interface-test.expect (= (net-interface.udp-dropped F) 1) "one UDP overflow drop")
           (net-interface-test.expect (= (net-link.packet-recv-into Left Wire) 31) "ICMP reply while inbox full")
           (net-interface-test.expect (buffer.equal? Wire Reply) "exact ICMP echo reply")
           (net-interface-test.expect (= (net-interface.udp-recv-into F Short Info) udp.too-small) "short UDP output")
           (net-interface-test.expect (= (udp.recv-info.port Info) 0) "short output leaves metadata alone")
           (net-interface-test.expect (= (net-interface.udp-recv-into F Out Info) udp.received) "retry UDP receive")
           (net-interface-test.expect (and (buffer.equal? Out Payload) (= (udp.recv-info.source Info) A)
                                           (= (udp.recv-info.port Info) 12345) (= (udp.recv-info.length Info) 3))
                                      "UDP payload and metadata")
           (net-interface-test.expect (= (net-interface.udp-recv-into F Out Info) udp.empty) "overflow datagram dropped")
           (output "1 passed, 0 failed~%")
           true)))

(define net-interface-test.host
  {--> boolean}
  -> (let Link (net-link.make 4 128 5 (freeze 0))
          Left (net-link.left Link)
          Right (net-link.right Link)
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          Client (net-interface.make-host Left A [49152] 2 123 0 [] 0)
          Server (net-interface.make-host Right B [80 81] 2 789 678 [7 8] 1)
          C (net-interface.interface.listener Client)
          S (net-interface.interface.listener Server)
          T1 (net-interface.connect Client B 80)
          T2 (net-interface.connect Client B 81)
       (do (net-interface-test.expect (and (fx> T1 0) (fx> T2 0) (not (= T1 T2))) "two active opens")
           (net-interface-test.expect (= (net-interface.connect Client B 80) 0) "bounded connection table")
           (net-interface-test.expect (= (net-interface.next-deadline Client) 0) "SYNs ready now")
           (net-interface.poll Client 0)
           (net-interface-test.expect (= (net-interface.next-deadline Server) 5) "queued ingress deadline")
           (net-interface-test.expect (= (net-interface.next-deadline Client) 1000) "SYN retransmission deadline")
           (net-interface-test.expect (not (tcp.connection-writable? C T1)) "handshake before writes")
           (net-interface-test.expect (= (tcp.accept-on S 81) 0) "accept before handshake")
           (output "1 passed, 0 failed~%")
           true)))

(define net-interface-test.pair-step
  {net-interface.interface --> net-interface.interface --> (vector fixnum) --> fixnum --> boolean}
  Client Server Time At ->
    (do (fxvector-> Time 1 At)
        (net-interface.poll Client 8)
        (net-interface.poll Server 8)
        true))

(define net-interface-test.clock
  {fixnum --> (vector fixnum)}
  Now -> (fxvector-> (vector 1) 1 Now))

(define net-interface-test.multiport
  {--> boolean}
  -> (let Time (net-interface-test.clock 0)
          Link (net-link.make 8 128 5 (freeze (fx<-vector Time 1)))
          Left (net-link.left Link)
          Right (net-link.right Link)
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          Client (net-interface.make-host Left A [49152] 2 123 0 [] 0)
          Server (net-interface.make-host Right B [80 81] 2 789 678 [7 8] 1)
          C (net-interface.interface.listener Client)
          S (net-interface.interface.listener Server)
          U7 (net-interface.udp-binding Server 7)
          U8 (net-interface.udp-binding Server 8)
          U (udp.bind Left A 1000)
          P (buffer.from-string "hello")
          Out (buffer.new 5)
          Info (udp.make-recv-info)
          T1 (net-interface.connect Client B 80)
          T2 (net-interface.connect Client B 81)
       (do (net-interface-test.expect (= (udp.send U B 7 P 4) udp.sent) "first UDP port")
           (net-interface-test.expect (= (udp.send U B 7 P 5) udp.sent) "overflow first UDP port")
           (net-interface-test.expect (= (udp.send U B 8 P 5) udp.sent) "second UDP port")
           (net-interface-test.pair-step Client Server Time 0)
           (net-interface-test.pair-step Client Server Time 5)
           (net-interface-test.pair-step Client Server Time 10)
           (net-interface-test.pair-step Client Server Time 15)
           (let S2 (tcp.accept-on S 81)
                S1 (tcp.accept-on S 80)
             (do (net-interface-test.expect (and (fx> S1 0) (fx> S2 0) (not (= S1 S2))) "accept by port")
                 (net-interface-test.expect (and (tcp.connection-writable? C T1) (tcp.connection-writable? C T2)
                                                 (not (tcp.connection-readable? S S1))) "stream readiness")
                 (net-interface-test.expect (= (tcp.connection-send C T2 P 5) 5) "write second stream")
                 (net-interface-test.pair-step Client Server Time 15)
                 (net-interface-test.pair-step Client Server Time 20)
                 (net-interface-test.expect (and (tcp.connection-readable? S S2)
                                                 (not (tcp.connection-readable? S S1))) "TCP tuple demultiplexing")
                 (net-interface-test.expect (= (tcp.connection-recv-into S S2 Out 5) 5) "read second stream")))
           (net-interface-test.expect (and (udp.inbox-ready? U7) (udp.inbox-ready? U8)
                                           (= (udp.inbox.dropped U7) 1) (= (udp.inbox.dropped U8) 0))
                                      "independent UDP queues")
           (net-interface-test.expect (and (= (udp.inbox-recv-into U8 Out Info) udp.received)
                                           (= (udp.recv-info.length Info) 5)
                                           (buffer.equal? Out P)
                                           (not (udp.inbox-ready? U8))) "receive second UDP port")
           (output "1 passed, 0 failed~%")
           true)))

(define net-interface-test.fragment
  {buffer.view --> buffer.view --> fixnum --> fixnum --> fixnum --> boolean --> buffer.view}
  Out B At Count Id More ->
    (do (buffer.copy-into! Out 0 B 0 20)
        (buffer.copy-into! Out 20 B (fx+ 20 At) Count)
        (buffer.u16-be-> Out 2 (fx+ Count 20))
        (buffer.u16-be-> Out 4 Id)
        (buffer.u16-be-> Out 6 (fx+ (fxquotient At 8) (if More 8192 0)))
        (buffer.u16-be-> Out 10 0)
        (buffer.u16-be-> Out 10 (net-ipv4.packet-checksum Out 0 20))))

(define net-interface-test.fragments
  {--> boolean}
  -> (let Time (net-interface-test.clock 0)
          Link (net-link.make 5 128 0 (freeze (fx<-vector Time 1)))
          Left (net-link.left Link)
          Right (net-link.right Link)
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          Server (net-interface.make-host Right B [] 1 1 2 [7] 1)
          P (buffer.from-string "IPv4 fragments")
          Out (buffer.new 14)
          Info (udp.make-recv-info)
          Whole (udp.write-packet (buffer.new 42) 0 A 1024 B 7 P 0 14)
          First (buffer.new 36)
          Last (buffer.new 26)
       (do (net-interface-test.fragment First Whole 0 16 111 true)
           (net-interface-test.fragment Last Whole 16 6 111 false)
           (net-link.packet-send Left Last 26)
           (net-interface.poll Server 1)
           (net-interface-test.expect (= (net-interface.udp-recv-into Server Out Info) udp.empty) "wait for fragment zero")
           (net-link.packet-send Left First 36)
           (net-interface.poll Server 1)
           (net-interface-test.expect (and (= (net-interface.udp-recv-into Server Out Info) udp.received)
                                           (buffer.equal? P Out)) "reassemble out of order")
           (net-interface-test.fragment First Whole 0 16 222 true)
           (net-interface-test.fragment Last Whole 16 6 222 false)
           (net-link.packet-send Left First 36)
           (net-link.packet-send Left First 36)
           (net-link.packet-send Left Last 26)
           (net-interface.poll Server 3)
           (net-interface-test.expect (= (net-interface.udp-recv-into Server Out Info) udp.empty) "reject overlap")
           (fxvector-> Time 1 30000)
           (net-link.packet-send Left Last 26)
           (net-link.packet-send Left First 36)
           (net-interface.poll Server 2)
           (net-interface-test.expect (= (net-interface.udp-recv-into Server Out Info) udp.received)
                                      "fragment slot reused after expiry")
           (output "1 passed, 0 failed~%")
           true)))

(define net-interface-test.errors
  {--> boolean}
  -> (let Link (net-link.make 4 128 0 (freeze 0))
          Left (net-link.left Link)
          Right (net-link.right Link)
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          Client (net-interface.make-host Left A [] 1 10 20 [] 0)
          Server (net-interface.make-host Right B [80] 1 30 40 [] 0)
          C (net-interface.interface.listener Client)
          U (udp.bind Left A 2000)
          P (buffer.from-string "hello")
          Wire (buffer.new 128)
          Token (net-interface.connect Client B 81)
       (do (net-interface.poll Client 1)
           (net-interface.poll Server 1)
           (net-interface.poll Client 1)
           (net-interface-test.expect (and (= (tcp.connection-state C Token) tcp.reset) (tcp.release C Token))
                                      "closed TCP port resets active open")
           (udp.send U B 81 P 5)
           (net-interface.poll Server 1)
           (net-interface-test.expect (= (net-link.packet-recv-into Left Wire) 56) "ICMP error quotes eight bytes")
           (net-interface-test.expect (and (= (buffer.u16-be Wire 20) 771)
                                           (= (buffer.u16-be Wire 50) 81)
                                           (= (net-ipv4.packet-checksum Wire 20 36) 0))
                                      "ICMP port unreachable")
           (output "1 passed, 0 failed~%")
           true)))

(define net-interface-test.pump-pair
  {net-interface.interface --> net-interface.interface --> fixnum --> boolean}
  _ _ 0 -> true
  C S N -> (do (net-interface.poll C 8)
               (net-interface.poll S 8)
               (net-interface-test.pump-pair C S (fx- N 1))))

(define net-interface-test.window-scale
  {--> boolean}
  -> (let Link (net-link.make 8 1500 0 (freeze 0))
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          Client (net-interface.make-host-sized (net-link.left Link) A [] 1 10 20 [] 0 131072)
          Server (net-interface.make-host-sized (net-link.right Link) B [80] 1 30 40 [] 0 131072)
          C (net-interface.interface.listener Client)
          S (net-interface.interface.listener Server)
          Token (net-interface.connect Client B 80)
          P (buffer.new 100000)
          Out (buffer.new 100000)
       (do (buffer.u8-> P 99999 42)
           (net-interface-test.pump-pair Client Server 3)
           (let Accepted (tcp.accept-on S 80)
             (do (net-interface-test.expect (= (tcp.connection-send C Token P 100000) 100000) "large send buffer")
                 (net-interface-test.pump-pair Client Server 80)
                 (net-interface-test.expect (= (tcp.connection-recv-into S Accepted Out 100000) 100000)
                                            "scaled receive window carries over 64 KiB without draining")
                 (net-interface-test.expect (buffer.equal? Out P) "large receive contents")
                 (net-interface-test.expect (tcp.connection-abort C Token) "abort established stream")
                 (net-interface-test.pump-pair Client Server 2)
                 (net-interface-test.expect (and (= (tcp.connection-state S Accepted) tcp.reset)
                                                 (tcp.release S Accepted) (tcp.release C Token)) "abort delivered reset")))
           (output "1 passed, 0 failed~%")
           true)))

(define net-interface-test.pmtu
  {--> boolean}
  -> (let Link (net-link.make 8 1500 0 (freeze 0))
          Left (net-link.left Link)
          Right (net-link.right Link)
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          Router (net-ipv4.address 192 0 2 3)
          Client (net-interface.make-host-sized Left A [] 1 10 20 [] 0 8192)
          Server (net-interface.make-host-sized Right B [80] 1 30 40 [] 0 8192)
          C (net-interface.interface.listener Client)
          Token (net-interface.connect Client B 80)
          Payload (buffer.new 1460)
          Big (buffer.new 1500)
          Error (buffer.new 56)
       (do (net-interface-test.pump-pair Client Server 3)
           (tcp.connection-send C Token Payload 1460)
           (net-interface.poll Client 0)
           (net-interface-test.expect (= (net-link.packet-recv-into Right Big) 1500) "original full-size segment")
           (net-ipv4.write-header Error 0 56 1 Router A)
           (buffer.u16-be-> Error 20 772)
           (buffer.u16-be-> Error 26 600)
           (buffer.copy-into! Error 28 Big 0 28)
           (buffer.u16-be-> Error 22 (net-ipv4.packet-checksum Error 20 36))
           (net-link.packet-send Right Error 56)
           (net-interface.poll Client 1)
           (net-interface-test.expect (= (net-link.packet-recv-into Right Error) -2) "retry queued before RTO")
           (net-interface-test.expect (and (= (net-link.packet-recv-into Right Big) 600)
                                           (= (net-ipv4.transport-checksum Big 0 6 580) 0)) "resegment at reduced path MTU")
           (output "1 passed, 0 failed~%")
           true)))

\\ A segment from A's port 12345 to B's port 80, without options or data.
(define net-interface-test.segment
  {buffer.view --> fixnum --> fixnum --> fixnum --> fixnum --> fixnum --> buffer.view}
  B From To Seq Ack Flags ->
    (do (net-ipv4.write-header B 0 40 6 From To)
        (buffer.u16-be-> B 20 12345)
        (buffer.u16-be-> B 22 80)
        (buffer.u32-be-> B 24 Seq)
        (buffer.u32-be-> B 28 Ack)
        (buffer.u16-be-> B 32 (fx+ 20480 Flags))                              \\ Five words of header.
        (buffer.u16-be-> B 34 8192)
        (buffer.u32-be-> B 36 0)
        (buffer.u16-be-> B 36 (net-ipv4.transport-checksum B 0 6 20))))

\\ A SYN that offers no maximum segment size gets IPv4's default, 536 bytes, from a table whose own is larger.
(define net-interface-test.default-mss
  {--> boolean}
  -> (let Link (net-link.make 8 1500 0 (freeze 0))
          Left (net-link.left Link)
          A (net-ipv4.address 192 0 2 1)
          B (net-ipv4.address 192 0 2 2)
          Server (net-interface.make-host-sized (net-link.right Link) B [80] 1 30 40 [] 0 8192)
          S (net-interface.interface.listener Server)
          Wire (buffer.new 1500)
          Data (buffer.new 600)
       (do (net-interface-test.segment Wire A B 1000 0 2)
           (net-link.packet-send Left Wire 40)
           (net-interface.poll Server 1)
           (net-interface-test.expect (= (net-link.packet-recv-into Left Wire) 44) "SYN-ACK to a SYN without options")
           (net-interface-test.segment Wire A B 1001 (fx+ (buffer.u32-be Wire 24) 1) 16)
           (net-link.packet-send Left Wire 40)
           (net-interface.poll Server 1)
           (let Token (tcp.accept-on S 80)
             (do (net-interface-test.expect (= (tcp.connection-send S Token Data 600) 600)
                                            "queue a write larger than the default size")
                 (net-interface.poll Server 1)
                 (net-interface-test.expect (= (net-link.packet-recv-into Left Wire) 576)
                                            "segments of the default size")))
           (output "1 passed, 0 failed~%")
           true)))
