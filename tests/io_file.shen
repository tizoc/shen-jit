\\ Native descriptors, binary files and caller-owned foreign ranges.
(set io-file-test.passed 0)
(set io-file-test.failed 0)
(define io-file-test.check
  Name Expected F -> (let Got (trap-error (thaw F) (/. X [raised (error-to-string X)]))
    (if (= Expected Got) (set io-file-test.passed (+ 1 (value io-file-test.passed)))
        (do (output "FAIL ~A: expected ~S, got ~S~%" Name Expected Got)
            (set io-file-test.failed (+ 1 (value io-file-test.failed)))))))
(define io-file-test.raises
  Name F -> (io-file-test.check Name true (freeze (trap-error (do (thaw F) false) (/. X true)))))
(define io-file-test.ok [ok V] -> V)
(define io-file-test.err [error E] -> E)
(define io-file-test.path Name -> (cn (value io-file-test.root) (cn "/" Name)))

(let Result (io.open-file (io-file-test.path "absent") read)
  (if (and (= (hd Result) error)
           (= (io.error-message (io-file-test.err Result)) "foreign: this static build cannot load libraries"))
      (do (output "1 passed, 0 failed (a static build)~%") (shen-jit.exit 0)) skip))

(let Path (io-file-test.path "binary") V (buffer.from-string "ac#0;c#13;c#10;c#26;z") _ (buffer.u8! V 5 255)
  (do (io-file-test.check "write binary file" [ok 6] (freeze (io.write-file Path V)))
      (io-file-test.check "read binary file" true (freeze (buffer.equal? V (io-file-test.ok (io.read-file Path 6)))))
      (io-file-test.check "read limit" 5 (freeze (io.error-progress (io-file-test.err (io.read-file Path 5)))))
      (io-file-test.raises "invalid write validated before truncating" (freeze (io.write-file Path [])))
      (io-file-test.check "invalid source leaves file intact" true (freeze (buffer.equal? V (io-file-test.ok (io.read-file Path 6)))))
      (io-file-test.raises "negative aggregate limit" (freeze (io.read-file Path -1)))
      (io-file-test.raises "NUL file path" (freeze (io.open-file (cn Path "c#0;x") write)))
      (io-file-test.raises "empty path" (freeze (io.open-file "" read)))
      (io-file-test.raises "invalid mode" (freeze (io.open-file Path other)))
      (let E (io-file-test.ok (io.open-file Path read)) B (buffer.new 8)
        (do (io-file-test.check "file exact partial EOF" [eof 6] (freeze (io.read-exact E B [])))
            (io-file-test.check "file EOF" [eof] (freeze (io.read-some E B [])))
            (io-file-test.check "empty after EOF" [read 0] (freeze (io.read-some E (buffer.new 0) [])))
            (io-file-test.check "file close" [ok] (freeze (io.close E)))
            (io-file-test.check "file close idempotent" [ok] (freeze (io.close E)))
            (io-file-test.raises "closed descriptor read" (freeze (io.read-some E B [])))))))
(let Path (io-file-test.path "empty")
  (do (io-file-test.check "write empty file" [ok 0] (freeze (io.write-file Path (buffer.new 0))))
      (io-file-test.check "empty file limit zero" 0 (freeze (buffer.length (io-file-test.ok (io.read-file Path 0)))))))
(let Path (io-file-test.path "append") _ (io.write-file Path (buffer.from-string "ab"))
     E (io-file-test.ok (io.open-file Path append))
  (do (io-file-test.check "append write" [ok 2] (freeze (io.write-all E (buffer.from-string "cd") [])))
      (io.close E)
      (io-file-test.check "append preserves prefix" "abcd" (freeze (buffer.string (io-file-test.ok (io.read-file Path 4)))))
      (let RW (io-file-test.ok (io.open-file Path read-write)) B (buffer.new 2)
        (do (io-file-test.check "duplex file read" [ok 2] (freeze (io.read-exact RW B [])))
            (io-file-test.check "duplex file write shares position" [ok 2] (freeze (io.write-all RW (buffer.from-string "XY") [])))
            (io.close RW)))
      (io-file-test.check "read-write avoids truncation" "abXY" (freeze (buffer.string (io-file-test.ok (io.read-file Path 4)))))))
(let Before (value *home-directory*) _ (set *home-directory* (value io-file-test.root))
     Result (trap-error (let _ (io.write-file "relative" (buffer.from-string "home"))
                            V (io-file-test.ok (io.read-file "relative" 4))
                          (buffer.string V)) (/. X [raised (error-to-string X)]))
     _ (set *home-directory* Before)
  (io-file-test.check "relative file uses home directory snapshot" "home" (freeze Result)))
(let Path (io-file-test.path "unicode-λ.bin")
  (do (io-file-test.check "Unicode file path write" [ok 3] (freeze (io.write-file Path (buffer.from-string "utf"))))
      (io-file-test.check "Unicode file path read" "utf" (freeze (buffer.string (io-file-test.ok (io.read-file Path 3)))))))
(let E (io-file-test.err (io.open-file (io-file-test.path "absent") read)) Code (io.error-code E)
     _ (io.write-file (io-file-test.path "errno-noise") (buffer.new 0))
  (do (io-file-test.check "missing file operation" open (freeze (io.error-operation E)))
      (io-file-test.check "native error domain" (if (io.file-windows?) crt posix) (freeze (io.error-domain E)))
      (io-file-test.check "native error code is captured" true (freeze (and (> Code 0) (= (io.error-code E) Code))))))
(let Path (io-file-test.path "scope")
     Result (io.with-output-file Path
              (/. E (let W (io.writer E [[chunk-size 3]]) _ (io.write W (buffer.from-string "abcdefg")) [ok done])))
  (do (io-file-test.check "scope returns callback value" [ok done] (freeze Result))
      (io-file-test.check "scope flushes before closing" "abcdefg" (freeze (buffer.string (io-file-test.ok (io.read-file Path 7)))))
      (let Result (io.with-input-file Path (/. E (do (set io-file-test.captured E) (error "callback failed"))))
        (io-file-test.check "scope catches exception" shen (freeze (io.error-domain (io-file-test.err Result)))))
      (io-file-test.raises "exception scope closed resource"
        (freeze (io.read-some (value io-file-test.captured) (buffer.new 0) [])))))
(let Path (io-file-test.path "binary") M (memory.alloc 10) V (buffer.slice (buffer.wrap M) 2 6)
     E (io-file-test.ok (io.open-file Path read))
  (do (io-file-test.check "read into foreign view" [ok 6] (freeze (io.read-exact E V [])))
      (io-file-test.check "foreign read preserves margins" [0 97 255 0]
        (freeze [(shen-jit.u8 M 1) (buffer.u8 V 0) (buffer.u8 V 5) (shen-jit.u8 M 8)]))
      (io.close E)
      (io-file-test.check "write from foreign view" [ok 6]
        (freeze (io.write-file (io-file-test.path "foreign") V)))
      (let RO (shen-jit.pointer-read-only M) ReadOnly (buffer.wrap RO)
           Input (io.input-buffer (buffer.from-string "x"))
        (do (io-file-test.raises "read-only direct destination" (freeze (io.read-some Input ReadOnly [])))
            \\ Even an empty destination is checked, before probing the endpoint.
            (io-file-test.raises "read-only empty destination" (freeze (io.read-into (io.reader Input []) (buffer.slice ReadOnly 0 0))))
            (io-file-test.raises "read-only memory output" (freeze (io.output-buffer ReadOnly)))
            (io.close Input) (shen-jit.pointer-kill RO)))
      (memory.free M)
      (io-file-test.raises "dead foreign input" (freeze (io.input-buffer V)))))
(let Path (io-file-test.path "large") V (buffer.new 131089) _ (buffer.u8! V 0 17) _ (buffer.u8! V 131088 29)
  (do (io-file-test.check "multi-chunk file write" [ok 131089] (freeze (io.write-file Path V)))
      (io-file-test.check "multi-chunk file read" true
        (freeze (buffer.equal? V (io-file-test.ok (io.read-file Path 131089)))))
      (let E (io-file-test.ok (io.open-file Path read)) R (io.reader E [[chunk-size 4096]])
           First (hd (tl (io.read-chunk R))) _ (io.read-chunk R) _ (io.close E)
        (io-file-test.check "native chunk stays owned after refill and close" [4096 17]
          (freeze [(buffer.length First) (buffer.u8 First 0)])))))
\\ POSIX EBADF injection; Windows CRT invalid-parameter handlers can abort on a bad fd.
(if (io.file-windows?)
    (do (io-file-test.raises "Windows drive-relative path" (freeze (io.open-file "C:relative" read)))
        (let Bad (shen-jit.bytes->string (shen-jit.u8! (shen-jit.bytes 1) 0 255) 0 1)
             Err (io-file-test.err (io.open-file Bad read))
          (do (io-file-test.check "Windows invalid UTF-8 path domain" win32 (freeze (io.error-domain Err)))
              (io-file-test.check "Windows invalid UTF-8 path code" true (freeze (> (io.error-code Err) 0))))))
    (let E (io-file-test.ok (io.open-file (io-file-test.path "binary") read)) Token (io.endpoint.guard E)
     _ (io.file-c-close (io.file-fd Token)) Result (io.read-some E (buffer.new 1) [])
     Saved (io-file-test.err Result) _ (io.close E)
  (do (io-file-test.check "native read failure is not EOF" read (freeze (io.error-operation Saved)))
      (io-file-test.check "native read error survives close" true (freeze (> (io.error-code Saved) 0)))
      (io-file-test.check "failed close invalidates native token" 0 (freeze (shen-jit.pointer-address Token))))))
(let Closed (io.record [0])
     E (io.endpoint "throws" write 1 (function io.no-read)
                    (/. B (error "unexpected write exception"))
                    (freeze (do (address-> Closed 0 (+ 1 (<-address Closed 0))) [ok])))
  (do (io-file-test.raises "whole-file helper reraises unexpected exceptions"
        (freeze (io.write-file-open (buffer.from-string "a") [ok E])))
      (io-file-test.check "whole-file helper closes after unexpected exception" 1
        (freeze (<-address Closed 0)))))

\\ Force the blocking FFI path to copy while another task moves the heap.
(define io-file-test.collecting
  -> (if (value io-file-test.stop) (set io-file-test.worker done)
         (do (shen-jit.bytes 128) (shen-jit.collect) (io-file-test.collecting))))
(define io-file-test.wait
  Name -> (if (= (value Name) waiting) (io-file-test.wait Name) (value Name)))
(set io-file-test.stop false)
(set io-file-test.started waiting)
(set io-file-test.worker waiting)
(thread (freeze (do (set io-file-test.started ready) (io-file-test.collecting))))
(io-file-test.wait io-file-test.started)
(let V (buffer.new 131089) _ (buffer.u8! V 131088 73) Path (io-file-test.path "threaded")
     Written (io.write-file Path V) Read (io.read-file Path 131089)
     _ (set io-file-test.stop true) _ (io-file-test.wait io-file-test.worker)
  (do (io-file-test.check "blocking write with concurrent collections" [ok 131089] (freeze Written))
      (io-file-test.check "blocking read with concurrent collections" true
        (freeze (buffer.equal? V (io-file-test.ok Read))))))

(output "~A passed, ~A failed~%" (value io-file-test.passed) (value io-file-test.failed))
