"The kernel's Prolog through them: binding, undoing on failure, and an unbound result."
(value 100 (set shen.*prolog-memory* 100))
(value 2 (shen.ticket-number (shen.prolog-vector)))
(value true (shen.pvar? (shen.make-prolog-variable 2)))
(value t.pvar-prolog (defun t.pvar-prolog () (let B (shen.prolog-vector) (let X (shen.newpv B) (let Before (shen.lazyderef X B) (let Bound (shen.bindv X a B) (let After (shen.lazyderef X B) (let Undone (shen.unwind X B ok) (cons (= Before X) (cons After (cons Undone (cons (= (shen.lazyderef X B) X) (cons (shen.ticket-number B) ())))))))))))))
(value (true a ok true 3) (t.pvar-prolog))
"A query's vector goes back when it ends, for the next query: each starts at offset 2,
nested queries have their own, and one that makes a lambda keeps its vector."
(value t.pool-q (defun t.pool-q () (((((lambda B (lambda L (lambda K (lambda C (let X (shen.newpv B) (do (address-> B 3 junk) (shen.ticket-number B))))))) (shen.prolog-vector)) (@v true (@v 0 (vector 0)))) 0) (freeze true))))
(value (3 3 3) (cons (t.pool-q) (cons (t.pool-q) (cons (t.pool-q) ()))))
(value t.pool-inner (defun t.pool-inner () (((((lambda B (lambda L (lambda K (lambda C (let Y (shen.newpv B) (do (shen.bindv Y b B) (shen.deref Y B))))))) (shen.prolog-vector)) (@v true (@v 0 (vector 0)))) 0) (freeze true))))
(value t.pool-outer (defun t.pool-outer () (((((lambda B (lambda L (lambda K (lambda C (let X (shen.newpv B) (do (shen.bindv X a B) (let I (t.pool-inner) (cons (shen.deref X B) (cons I ()))))))))) (shen.prolog-vector)) (@v true (@v 0 (vector 0)))) 0) (freeze true))))
(value ((a b) (a b)) (cons (t.pool-outer) (cons (t.pool-outer) ())))
(value t.pool-closure (defun t.pool-closure () (((((lambda B (lambda L (lambda K (lambda C (let X (shen.newpv B) (do (shen.bindv X 7 B) (lambda Y (shen.deref X B)))))))) (shen.prolog-vector)) (@v true (@v 0 (vector 0)))) 0) (freeze true))))
(value 7 (let F (t.pool-closure) (let Q1 (t.pool-q) (let Q2 (t.pool-outer) (F 0)))))
(value t.pvar-chain (defun t.pvar-chain () (let B (shen.prolog-vector) (let X (shen.newpv B) (let Y (shen.newpv B) (let Z (shen.newpv B) (do (shen.bindv X Y B) (do (shen.bindv Y (cons Z 1) B) (do (shen.bindv Z 2 B) (cons (shen.lazyderef Z B) (cons (hd (shen.deref X B)) (cons (tl (shen.deref X B)) ()))))))))))))
(value (2 2 1) (t.pvar-chain))
"A cut then (when false), which the lowerer folds: it fails, and locks the
lock with its key only when the lock is open."
(value t.cut-fail (defun t.cut-fail (B L K C) (shen.cut B L K (freeze (when false B L K C)))))
(value t.lock-after (defun t.lock-after (Open) (let L (address-> (address-> (absvector 3) 1 Open) 2 5) (let R (t.cut-fail 0 L 7 0) (cons R (cons (<-address L 1) (cons (<-address L 2) ())))))))
(value (false false 7) (t.lock-after true))
(value (false false 5) (t.lock-after false))
"(= (shen.deref X B) (shen.deref Y B)), compared without copying: equal through
variables, different at the head, a pair and an atom, unbound variables, and a term
that holds itself, whose copy would not end."
(value t.deref-eq (defun t.deref-eq (X Y B) (= (shen.deref X B) (shen.deref Y B))))
(value t.deref-eq-all (defun t.deref-eq-all () (let B (shen.prolog-vector) (let X (shen.newpv B) (let Y (shen.newpv B) (let Z (shen.newpv B) (let U (shen.newpv B) (let V (shen.newpv B) (let C (shen.newpv B) (do (shen.bindv X (cons Z (cons 1 ())) B) (do (shen.bindv Y (cons 2 (cons 1 ())) B) (do (shen.bindv Z 2 B) (do (shen.bindv C (cons C 1) B) (cons (t.deref-eq X Y B) (cons (t.deref-eq X (cons 3 (cons 1 ())) B) (cons (t.deref-eq X Z B) (cons (t.deref-eq Z 2 B) (cons (t.deref-eq U U B) (cons (t.deref-eq U V B) (cons (t.deref-eq C C B) ()))))))))))))))))))))
(value (true false false true true false true) (t.deref-eq-all))

"Isolates, here also under GC stress and the sanitizers: one that sends back what it was
given, and two whose lists collections move while the builder allocates its own. Everything is
defined first, as the program cannot change while another isolate runs, and each case waits for
its isolates to end, as cases after it define more."
(value t.reply (defun t.reply (X) (channel.send (hd X) (tl X))))
(value t.build (defun t.build (N) (if (= N 0) () (cons N (t.build (- N 1))))))
(value t.sum (defun t.sum (L) (if (cons? L) (+ (hd L) (t.sum (tl L))) 0)))
(value t.churn (defun t.churn (N A) (if (= N 0) A (t.churn (- N 1) (t.sum (t.build 50))))))
(value t.churn-reply (defun t.churn-reply (S) (channel.send S (t.churn 200 0))))
(value t.ended (defun t.ended (P) (channel.receive (isolate.monitor P))))
(value (7 "seven" seven) (let R (channel.new 1) (let P (isolate.spawn t.reply (cons (channel.sender R) (cons 7 (cons "seven" (cons seven ()))))) (let Got (channel.receive R) (do (t.ended P) Got)))))
(value (1275 1275 1275) (let R (channel.new 2) (let S (channel.sender R) (let P (isolate.spawn t.churn-reply S) (let Q (isolate.spawn t.churn-reply S) (let M (t.churn 200 0) (let Got (cons M (cons (channel.receive R) (cons (channel.receive R) ()))) (do (t.ended P) (do (t.ended Q) Got)))))))))
(error "isolate.spawn: 1 is not a function of one argument that the builder defined" (isolate.spawn 1 2))

